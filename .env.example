# Generate a random secret with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for db:setup only. Remove after account creation.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Enable only for a local demonstration; db:setup -- --demo seeds mock models.
APP_ENABLE_DEMO=0
# Local HTTP only. Keep disabled for HTTPS installations.
APP_ALLOW_INSECURE_HTTP=0

# Custom server-side JavaScript adapters and nodes are disabled by default.
APP_ENABLE_TRUSTED_CODE=0
