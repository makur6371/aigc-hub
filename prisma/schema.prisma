// 邮箱验证码
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   @default("register") // register / reset_password
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verifications")
}

// SMTP 发件配置(单条记录,key 固定为 primary)
model SmtpConfig {
  id          String   @id @default("primary")
  host        String
  port        Int
  username    String
  password    String
  senderEmail String   @map("sender_email")
  senderName  String   @map("sender_name")
  updatedAt   DateTime @updatedAt

  @@map("smtp_configs")
}

// 支付渠道开关（单条记录，key 固定为 primary）。
// 验证码策略(单条记录,key 固定为 primary)
model VerificationPolicy {
  id                String   @id @default("primary")
  codeExpiryMinutes Int      @default(10) @map("code_expiry_minutes")
  resendCooldownSec Int      @default(60) @map("resend_cooldown_sec")
  updatedAt         DateTime @updatedAt

  @@map("verification_policies")
}

// Agent 全局配置（单条记录,key 固定为 primary）：规划模型锁定等
model AgentConfig {
  id                     String   @id @default("primary")
  planningModelId        String?  @unique @map("planning_model_id")
  // 规划模型「替补链」：主模型（planningModelId）失败/超时后，按这里的顺序依次降级。
  // 存 ModelConfig.id 的 JSON 数组（有序）。为空 = 退回旧行为（其余启用模型按 isFree/createdAt 排）。
  // 用 Json 而非关系表：这是一条**有序短列表**（通常 1~4 个），不需要独立查询/外键级联。
  planningBackupModelIds Json?    @map("planning_backup_model_ids")
  updatedAt              DateTime @updatedAt

  planningModel ModelConfig? @relation(fields: [planningModelId], references: [id], onDelete: SetNull)

  @@map("agent_configs")
}

// 管理员人工核验操作日志
model AdminActionLog {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  userId    String   @map("user_id")
  action    String // manual_verify
  note      String?
  createdAt DateTime @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_action_logs")
}

// IP 注册频率限制
model RateLimit {
