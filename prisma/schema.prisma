  ip        String
  action    String // register / send_code
  count     Int      @default(1)
  windowAt  DateTime @map("window_at") // 时间窗口起始
  createdAt DateTime @default(now())

  @@unique([ip, action, windowAt])
  @@index([ip, action])
  @@map("rate_limits")
}

model SystemAnnouncement {
  id          String    @id @default(cuid())
  title       String
  content     String
  type        String    @default("general") // general=常规 / featured=精选
  isActive    Boolean   @default(true)
  // 上线时间：null=立即上线；非 null 时未到时间不对外展示
  publishedAt DateTime?
  // 下线时间：null=不过期；非 null 时到期后不再对外展示（活动公告自动收摊）
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("system_announcements")
}


// ===== P10: 企业 AI 使用情况调研 =====
// 一次调研 = 一张问卷（问题树 JSON）。模板按 audience 发放：
//   ALL  = 全站用户可见
//   TEAM = 只对某企业的 owner + 成员可见（每企业可定制差异题）
// 回答一人一卷（userId + templateId 唯一）：重复提交走 upsert 覆盖，
// 因为问卷是逐题作答的树形结构，改答案重新提交应整体替换而非追加。
model SurveyTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  // 问题树：数组，每项 { id, section, title, type: single|multi|text, options?, required?, showIf?: {qid: value} }
  // showIf 是「父题选了某选项才显示」的分支条件，与前端逐题渲染引擎共用同一份 schema。
  questions   Json
  audience    String   @default("ALL") // ALL / TEAM
  targetTeamId String? @map("target_team_id") // audience=TEAM 时生效；null 表示已按 team 下发（记录最后一次目标）
  isActive    Boolean  @default(true)
  // 答完奖励：>0 时管理员可一键给所有已提交者发积分（一次性，rewardGrantedAt 防重发）
  rewardPoints Float    @default(0) @map("reward_points")
  rewardGrantedAt DateTime? @map("reward_granted_at")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses   SurveyResponse[]
  @@map("survey_templates")
}

model SurveyResponse {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  userId     String   @map("user_id")
  // {qid: answer}，answer 为 string（单选/文本）或 string[]（多选）
  answers    Json
  submittedAt DateTime @map("submitted_at")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template SurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User           @relation("SurveyResponses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([userId])
  @@map("survey_responses")
}

// ===== P9: 作品广场/分享 =====
model SharedWork {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  type        String   @default("workflow") // workflow / image / video
  category    String? // 作品分类（继承发布来源工具的分类，或用户手选）
  nodes       Json? // 发布时快照
  connections Json?
  coverUrl    String?
  images      Json? // 套图：发布时画布产出的全部图片 URL 数组（coverUrl=其中最后生成的，套图排版用）
  coverLayout Json? // 套图自定义排版：{ ratio: string, cells: [{url, x, y, w, h}] }（发布弹窗排版编辑器生成，作品广场按此渲染）
  status      String   @default("PENDING") // PENDING / APPROVED / REJECTED
  featured    Boolean  @default(false) // 首页精选展示（管理员勾选）
  authorId    String
  likeCount   Int      @default(0)
  viewCount   Int      @default(0)
  version     Int      @default(1)
  embedding   String? // 语义搜索向量(JSON 数组)，供 embedding 相似度检索
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("shared_works")
}

// ===== MCP：画布接入配对码（明文码仅生成时返回一次，DB 只存 sha256） =====
model McpPairing {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("MCP 接入") // 用户自定义备注（如"Claude Code 笔记本"）
  codeHash   String    @unique // sha256(mkp_...明文码)
  codeTail   String    @default("") // 明文码尾 4 位，列表展示用
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  lastUsedIp String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_pairings")
}

// ===== 工具系统：画布工作流复存为可重复执行的工具 =====
model Tool {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  coverUrl    String?
  category    String? // 电商商拍 / 角色设计 / 智能修图 / 视频生成 …
  tags        String?
  isOfficial  Boolean  @default(false)
  status      String   @default("PENDING") // PENDING / APPROVED / REJECTED
  workflow    Json // { nodes, connections } 画布快照（与 canvas 执行协议同构）
  slots       Json // Slot[] 面板控件清单（tool-slots.ts 识别引擎生成，作者向导微调）
  forkedFrom  String? // remix 溯源（源工具 id）
  useCount    Int      @default(0)
  likeCount   Int      @default(0)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, category])
  @@index([authorId])
  @@map("tools")
}
